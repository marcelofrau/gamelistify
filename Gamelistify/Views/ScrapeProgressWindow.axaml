<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gamelistify.ViewModels"
        x:Class="Gamelistify.Views.ScrapeProgressWindow"
        x:DataType="vm:ScrapeProgressViewModel"
        Title="Scrape Progress"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Border Margin="16" Classes="panel" Padding="16">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <TextBlock Grid.Row="0" Classes="section-title" Text="{Binding Title}" />
      <TextBlock Grid.Row="1" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
      <ListBox Grid.Row="2" ItemsSource="{Binding LogLines}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New, monospace" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="command-button" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" ToolTip.Tip="Cancel the current scrape operation" />
        <Button Classes="command-button primary" Content="Close" IsEnabled="{Binding CanClose}" Click="OnCloseClick" ToolTip.Tip="Close progress view and refresh list" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
