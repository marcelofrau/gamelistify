<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gamelistify.Views.BatchFavoriteWindow"
        x:DataType="vm:BatchFavoriteViewModel"
        xmlns:vm="using:Gamelistify.ViewModels"
        Title="Batch Favorite by Names"
        Width="520"
        Height="460"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Classes="panel" Padding="18">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
      <TextBlock Classes="section-title" FontSize="18" Text="Batch Favorite by Names" />
      <StackPanel Spacing="4">
        <TextBlock Text="Enter one game name per line. Every matching entry in the gamelist will be favorited." TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="Names are matched case-insensitively." />
      </StackPanel>
      <TextBox Grid.Row="2"
               Text="{Binding NamesText, Mode=TwoWay}"
               AcceptsReturn="True"
               PlaceholderText="e.g.&#x0a;Super Mario Bros. (USA)&#x0a;The Legend of Zelda (Europe)"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Mono,Consolas,monospace" />
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <Button Grid.Column="1" MinWidth="100" Classes="command-button" Click="OnCancelClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-close-32.png" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" MinWidth="100" Classes="command-button primary" Click="OnOkClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-favorite-32.png" />
            <TextBlock Text="Favorite" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
