<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gamelistify.ViewModels"
        x:Class="Gamelistify.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="620"
        Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Classes="panel" Padding="18">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
      <TextBlock Grid.Row="0" Classes="section-title" Text="Application Settings" />

      <Grid Grid.Row="1" ColumnDefinitions="170,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" Text="Skyscraper binary" />
        <TextBox Grid.Column="1" Text="{Binding SkyscraperBinaryPath}" />
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="170,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" Text="ScreenScraper user" />
        <TextBox Grid.Column="1" Text="{Binding ScreenScraperUser}" />
      </Grid>

      <Grid Grid.Row="3" ColumnDefinitions="170,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" Text="ScreenScraper password" />
        <TextBox Grid.Column="1" PasswordChar="*" Text="{Binding ScreenScraperPassword}" />
      </Grid>

      <Grid Grid.Row="4" ColumnDefinitions="170,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" Text="Image preview size" />
        <NumericUpDown Grid.Column="1" Minimum="120" Maximum="520" Increment="10" Value="{Binding ImagePreviewSize}" />
      </Grid>

      <Grid Grid.Row="5" ColumnDefinitions="170,*" ColumnSpacing="10">
        <TextBlock VerticalAlignment="Center" Text="Log level" ToolTip.Tip="Changes apply immediately. Not persisted between restarts." />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding LogLevelOptions}"
                  SelectedIndex="{Binding SelectedLogLevelIndex}"
                  HorizontalAlignment="Stretch" />
      </Grid>

      <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="command-button primary" Command="{Binding SaveCommand}" Click="OnSaveClick" ToolTip.Tip="Save settings and close">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Width="16" Height="16" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-save-32.png" />
            <TextBlock Text="Save" />
          </StackPanel>
        </Button>
        <Button Classes="command-button" Click="OnCancelClick" ToolTip.Tip="Discard changes and close">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Width="16" Height="16" Source="avares://Gamelistify/Assets/Views/AboutWindow/aboutwindow-close-32.png" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
