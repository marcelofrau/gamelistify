<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Gamelistify.Views.ExitConfirmWindow"
        x:DataType="vm:ExitConfirmViewModel"
        xmlns:vm="using:Gamelistify.ViewModels"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Border Margin="16" Classes="panel" Padding="18">
    <StackPanel Spacing="16">
      <TextBlock Text="{Binding Title}" Classes="section-title" FontSize="18" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="1" MinWidth="110" Classes="command-button" Click="OnCancelClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-cancel-32.png" />
            <TextBlock Text="Cancel" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" MinWidth="150" Classes="command-button" Click="OnDiscardClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-open-32.png" />
            <TextBlock Text="Exit without Saving" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" MinWidth="130" Classes="command-button primary" Click="OnSaveAndExitClick">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-save-32.png" />
            <TextBlock Text="Save and Exit" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</Window>
