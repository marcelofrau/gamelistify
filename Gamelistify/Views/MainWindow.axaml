<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Gamelistify.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Gamelistify.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/gamelistify.ico"
        Title="{Binding WindowTitle}"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    </Window.KeyBindings>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0">
        <Border Grid.Row="0" Classes="toolbar-shell" Padding="8,6" Margin="0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="0">
                <Button Grid.Column="0" Classes="command-button toolbar-button" Command="{Binding OpenCommand}" ToolTip.Tip="Open a gamelist.xml file">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-open-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Open" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="command-button toolbar-button" Command="{Binding SaveCommand}" ToolTip.Tip="Save current gamelist and create a backup">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-save-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Save" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="2" Classes="toolbar-group-separator" />
                <Button Grid.Column="3" Classes="command-button toolbar-button" Command="{Binding ScanRomsCommand}" ToolTip.Tip="Scan a ROM directory and add missing entries">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-scan-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="command-button toolbar-button" Command="{Binding ScrapeSelectedCommand}" ToolTip.Tip="Run Skyscraper for selected entries">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-scrapesel-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Scrape Sel" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Classes="command-button toolbar-button" Command="{Binding ScrapeAllCommand}" ToolTip.Tip="Run Skyscraper for the whole loaded library">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-scrapeall-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Scrape All" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="6" Classes="toolbar-group-separator" />
                <Button Grid.Column="7" Classes="command-button toolbar-button" Command="{Binding HideSelectedCommand}" ToolTip.Tip="Hide all selected entries">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-hide-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Hide" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="8" Classes="command-button toolbar-button" Command="{Binding UnhideSelectedCommand}" ToolTip.Tip="Unhide all selected entries">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-unhide-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Unhide" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="9" Classes="command-button toolbar-button" Command="{Binding FavoriteSelectedCommand}" ToolTip.Tip="Mark selected entries as favorites">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-favorite-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Fav" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="10" Classes="command-button toolbar-button" Command="{Binding UnfavoriteSelectedCommand}" ToolTip.Tip="Remove favorite flag from selected entries">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-unfavorite-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Unfav" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="11" Classes="toolbar-group-separator" />
                <Button Grid.Column="12" Classes="command-button toolbar-button" Command="{Binding RemoveSelectedEntriesCommand}" ToolTip.Tip="Remove selected entries from the gamelist">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-remove-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Remove" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="13" Classes="toolbar-group-separator" />
                <Button Grid.Column="15" Classes="command-button toolbar-button" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right" ToolTip.Tip="Open application settings">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-settings-32.png" />
                        <TextBlock Classes="toolbar-label" Text="Settings" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="16" Classes="command-button toolbar-button" Command="{Binding OpenAboutCommand}" HorizontalAlignment="Right" ToolTip.Tip="Show version, license, and project links">
                    <StackPanel Spacing="4">
                        <Image Classes="toolbar-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-about-32.png" />
                        <TextBlock Classes="toolbar-label" Text="About" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16,12,16,0">
            <Grid>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Search by name, genre, developer..." Padding="32,0,0,0" />
                <Path Data="{StaticResource IconSearch}"
                      Width="16" Height="16"
                      Fill="{StaticResource WorkbenchText}"
                      Opacity="0.35"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="8,0,0,0"
                      IsHitTestVisible="False"
                      Stretch="Uniform" />
            </Grid>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}"
                      Width="160" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,6,420" ColumnSpacing="0" Margin="16,12,16,0">
            <Border Grid.Column="0" Classes="panel" Padding="10">
                <DataGrid ItemsSource="{Binding VisibleEntries}"
                          x:Name="EntriesGrid"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          SelectionChanged="OnEntriesSelectionChanged"
                          SelectionMode="Extended"
                          RowBackground="#151413"
                          DoubleTapped="OnEntriesDoubleTapped">
                    <DataGrid.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedEntriesCommand}" />
                    </DataGrid.KeyBindings>
                    <DataGrid.RowTheme>
                        <ControlTheme TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Background" Value="{ReflectionBinding RowBackground}" />
                            <Setter Property="Foreground" Value="{ReflectionBinding RowForeground}" />
                        </ControlTheme>
                    </DataGrid.RowTheme>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="90" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
                        <DataGridCheckBoxColumn Header="Hidden" Binding="{Binding Hidden}" Width="90" />
                        <DataGridCheckBoxColumn Header="Favorite" Binding="{Binding Favorite}" Width="90" />
                        <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="140" />
                        <DataGridTextColumn Header="Developer" Binding="{Binding Developer}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" Width="5" />

            <Border Grid.Column="2" Classes="panel" Padding="10" Margin="6,0,0,0">
                <ScrollViewer>
                <StackPanel Spacing="10">
                    <Border MinHeight="160" Background="{StaticResource WorkbenchSurfaceAlt}" BorderBrush="{StaticResource WorkbenchAccent}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Border Background="#101012" CornerRadius="6">
                            <Grid>
                                <Image Classes="preview-image" Source="{Binding DetailImage}" IsVisible="{Binding HasDetailImage}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" IsVisible="{Binding ShowPreviewPlaceholder}" Text="No preview available" />
                            </Grid>
                        </Border>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBox x:Name="DetailNameBox" Text="{Binding DetailNameEdit}" PlaceholderText="Name" IsEnabled="{Binding HasSelection}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <TextBox Text="{Binding DetailGenreEdit}" PlaceholderText="Genre" IsEnabled="{Binding HasSelection}" />
                            <TextBox Grid.Column="1" Text="{Binding DetailDeveloperEdit}" PlaceholderText="Developer" IsEnabled="{Binding HasSelection}" />
                        </Grid>
                        <TextBox Text="{Binding DetailDescriptionEdit}" AcceptsReturn="True" Height="86" TextWrapping="Wrap" PlaceholderText="Description" IsEnabled="{Binding HasSelection}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="Favorite" IsChecked="{Binding DetailFavoriteEdit}" IsEnabled="{Binding HasSelection}" />
                            <CheckBox Content="Hidden" IsChecked="{Binding DetailHiddenEdit}" IsEnabled="{Binding HasSelection}" />
                            <CheckBox Content="Kid Game" IsChecked="{Binding DetailKidgameEdit}" IsEnabled="{Binding HasSelection}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBox Text="{Binding DetailPublisher}" PlaceholderText="Publisher" IsEnabled="{Binding HasSelection}" />
                        <TextBox Text="{Binding DetailPlayers}" PlaceholderText="Players" IsEnabled="{Binding HasSelection}" />
                        <TextBox Text="{Binding DetailVotes}" PlaceholderText="Votes" IsEnabled="{Binding HasSelection}" />
                        <TextBox Text="{Binding DetailReleaseDate}" PlaceholderText="Release Date" IsEnabled="{Binding HasSelection}" />
                        <TextBox Text="{Binding DetailLastPlayed}" PlaceholderText="Last Played" IsEnabled="{Binding HasSelection}" />
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button Width="26" Height="26" Padding="2" Background="Transparent" BorderThickness="0" Command="{Binding SetRatingCommand}" CommandParameter="1" IsEnabled="{Binding HasSelection}">
                                <Path Data="{StaticResource IconStar}" Fill="{Binding Star1Filled, Converter={StaticResource BoolToStarBrush}}" Stretch="Uniform" />
                            </Button>
                            <Button Width="26" Height="26" Padding="2" Background="Transparent" BorderThickness="0" Command="{Binding SetRatingCommand}" CommandParameter="2" IsEnabled="{Binding HasSelection}">
                                <Path Data="{StaticResource IconStar}" Fill="{Binding Star2Filled, Converter={StaticResource BoolToStarBrush}}" Stretch="Uniform" />
                            </Button>
                            <Button Width="26" Height="26" Padding="2" Background="Transparent" BorderThickness="0" Command="{Binding SetRatingCommand}" CommandParameter="3" IsEnabled="{Binding HasSelection}">
                                <Path Data="{StaticResource IconStar}" Fill="{Binding Star3Filled, Converter={StaticResource BoolToStarBrush}}" Stretch="Uniform" />
                            </Button>
                            <Button Width="26" Height="26" Padding="2" Background="Transparent" BorderThickness="0" Command="{Binding SetRatingCommand}" CommandParameter="4" IsEnabled="{Binding HasSelection}">
                                <Path Data="{StaticResource IconStar}" Fill="{Binding Star4Filled, Converter={StaticResource BoolToStarBrush}}" Stretch="Uniform" />
                            </Button>
                            <Button Width="26" Height="26" Padding="2" Background="Transparent" BorderThickness="0" Command="{Binding SetRatingCommand}" CommandParameter="5" IsEnabled="{Binding HasSelection}">
                                <Path Data="{StaticResource IconStar}" Fill="{Binding Star5Filled, Converter={StaticResource BoolToStarBrush}}" Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="{Binding DetailRating}" Classes="muted" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailImageEdit}" PlaceholderText="image" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="image" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for an image file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailVideoEdit}" PlaceholderText="video" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="video" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for a video file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailMarqueeEdit}" PlaceholderText="marquee" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="marquee" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for a marquee file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailWheelEdit}" PlaceholderText="wheel" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="wheel" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for a wheel file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailFanartEdit}" PlaceholderText="fanart" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="fanart" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for a fanart file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailThumbnailEdit}" PlaceholderText="thumbnail" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="thumbnail" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for a thumbnail file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Text="{Binding DetailScreenshotEdit}" PlaceholderText="screenshot" IsEnabled="{Binding HasSelection}" />
                            <Button Grid.Column="1" Width="34" Padding="0" Classes="command-button" Command="{Binding BrowseMediaCommand}" CommandParameter="screenshot" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Browse for a screenshot file">
                                <TextBlock Text="…" />
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource WorkbenchBorder}" Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="section-title" Text="Orphan Media" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="command-button" Command="{Binding FindOrphanMediaCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Find media files that exist on disk but are not linked to this entry">
                                <TextBlock Text="Find Orphan Media" />
                            </Button>
                        </Grid>
                        <TextBlock Classes="muted" Text="{Binding OrphanScanStatus}" TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding OrphanMediaItems}" MaxHeight="110" IsEnabled="{Binding HasSelection}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New, monospace" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Height="1" Background="{StaticResource WorkbenchBorder}" Margin="0,4" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="command-button primary" Command="{Binding SaveCommand}" IsEnabled="{Binding HasLoadedDocument}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-save-32.png" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                            <Button Classes="command-button" Command="{Binding RemoveEntryCommand}" IsEnabled="{Binding HasSelection}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-remove-32.png" />
                                    <TextBlock Text="Remove" />
                                </StackPanel>
                            </Button>
                            <Button Classes="command-button" Command="{Binding ReloadCommand}" IsEnabled="{Binding HasLoadedDocument}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Classes="dialog-icon" Source="avares://Gamelistify/Assets/Views/MainWindow/mainwindow-open-32.png" />
                                    <TextBlock Text="Discard" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="16,12,16,16" Padding="12,8" Background="{StaticResource WorkbenchSurface}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" Text="{Binding StatusText}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link-button" Content="Quick Tips" Padding="0" Background="Transparent" BorderThickness="0">
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <Border Background="{StaticResource WorkbenchSuccess}" BorderBrush="#1E3323" BorderThickness="1" CornerRadius="6" Padding="14,10" MinWidth="260" MaxWidth="340">
                                <StackPanel Spacing="8">
                                    <TextBlock Foreground="#222222" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CurrentTip}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button Width="26" Height="26" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Foreground="#222222" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Command="{Binding PreviousTipCommand}">
                                            <TextBlock Text="◀" FontSize="11" />
                                        </Button>
                                        <TextBlock Foreground="#222222" VerticalAlignment="Center" Text="{Binding TipCounter}" />
                                        <Button Width="26" Height="26" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Foreground="#222222" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Command="{Binding NextTipCommand}">
                                            <TextBlock Text="▶" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
    </Grid>

</Window>
